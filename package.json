{
  "name": "node-observatory-cloudflare",
  "version": "3.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "node --check src/index.js",
    "test": "node --test --no-warnings test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute node-observatory --remote --file=migrations/0001_init.sql",
    "build:obfuscated": "node scripts/build-obfuscated.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "terser": "^5.43.1"
  }
}
